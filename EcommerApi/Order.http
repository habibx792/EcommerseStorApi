# For more info on HTTP files go to https://aka.ms/vs/httpfile
@EcommerApi_HostAddress = https://localhost:7162

###############################################################
# Get All Orders
###############################################################

GET {{EcommerApi_HostAddress}}/Home/Orders


###

###############################################################
# Get Order By Id
###############################################################

GET {{EcommerApi_HostAddress}}/Home/Orders/1


###

###############################################################
# Place Order
###############################################################

POST {{EcommerApi_HostAddress}}/Home/PlaceOrder
Content-Type: application/json

{
    "userId": 3,
    "productIds": [1, 2, 3]
}

###

###############################################################
# Update Order Status
###############################################################

PUT {{EcommerApi_HostAddress}}/Home/UpdateOrder/1
Content-Type: application/json

{
  "orderStatus": 1
}

###

###############################################################
# Delete Order
###############################################################

DELETE {{EcommerApi_HostAddress}}/Home/DeleteOrder/1
Accept: application/json

###
